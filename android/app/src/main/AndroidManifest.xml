<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera.any" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <!--
      Android 11+ hides other packages unless they are queried for. Without the TTS_SERVICE
      entry TextToSpeech finds no engine and onInit reports ERROR; without the AR package
      entry we cannot read the installed Play Services for AR version.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.ar.core" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <!-- optional: the app still installs and can report UNSUPPORTED on non-AR phones -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ar.ArDiagnosticActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
